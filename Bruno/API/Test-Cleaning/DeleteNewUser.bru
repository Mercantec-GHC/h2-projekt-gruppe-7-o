meta {
  name: DeleteUser
  type: http
  seq: 4
}

delete {
  url: {{baseUrl}}/api/Users/{{User-Id}}
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{JWT-Admin}}
}

script:pre-request {
  const userId = bru.getEnvVar("User-Id");
  if (!userId) {
    console.log("⚠️ Intet bruger-ID fundet. Sørg for at køre registrering først.");
  } else {
    console.log("Sletter bruger med ID: " + userId);
  }

  const jwtToken = bru.getEnvVar("JWT-User");
  if (!jwtToken) {
    console.log("⚠️ Intet JWT-User token fundet. Sørg for at køre login først.");
  } else {
    console.log("JWT-User token fundet og bruges til autorisation");
  }
}

script:post-response {
  try {
    if (res.status === 200 || res.status === 204) {
      console.log("✅ Bruger slettet succesfuldt!");

      // Ryd op i relaterede variabler
      bru.deleteVar("User-Id");
      bru.deleteVar("User-Email");
      bru.deleteVar("User-Password");
      console.log("🧹 Oprydning: Alle bruger-variabler fjernet");

    } else if (res.status === 401) {
      console.log("❌ Unauthorized: JWT token er ugyldig eller udløbet");
    } else if (res.status === 403) {
      console.log("❌ Forbidden: Du har ikke tilladelse til at slette denne bruger");
    } else {
      console.log("❌ Fejl ved sletning af bruger. Status:", res.status);
      console.log("Response:", res.body);
    }
  } catch (error) {
    console.log("Fejl ved håndtering af slette-response:", error.message);
  }
}

tests {
  test("Sletning af bruger returnerer korrekt status", function() {
    expect(res.status).to.be.oneOf([200, 204]);
  });

  test("Response tid under 2 sekunder", function() {
    expect(res.responseTime).to.be.lessThan(2000);
  });

  test("Request har korrekt Authorization header", function() {
    const authHeader = req.getHeader("Authorization");
    expect(authHeader).to.include("Bearer ");
    expect(authHeader).to.have.length.greaterThan(10);
  });
}

settings {
  encodeUrl: true
}
