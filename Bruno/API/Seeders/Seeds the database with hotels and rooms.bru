meta {
  name: Seeds the database with hotels and rooms
  type: http
  seq: 2
  tags: [
    seed
  ]
}

post {
  url: {{baseUrl}}/api/Seeders/hotels
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{JWT-User}}
}

script:post-response {
  if (res.status === 200) {
    console.log("Database seedet med hotels og rooms succesfuldt.");
  } else {
    console.log("Seedning af hotels og rooms fejlede. Status:", res.status);
  }
}

tests {
  test("Hotels & Rooms seed returnerer 200 OK", function() {
    expect(res.status).to.equal(200);
  });
}
