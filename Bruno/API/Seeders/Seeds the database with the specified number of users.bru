meta {
  name: Seeds the database with the specified number of users
  type: http
  seq: 1
  tags: [
    seed
  ]
}

post {
  url: {{baseUrl}}/api/Seeders/users
  body: none
  auth: inherit
}

params:query {
  ~count: 10  // fx seed 10 brugere; kan ændres dynamisk
}

headers {
  Authorization: Bearer {{JWT-User}}
}

script:pre-request {
  // Gem antallet af brugere som miljøvariabel
  const userCount = 10;
  bru.setEnvVar("Seed-User-Count", userCount);
}

script:post-response {
  if (res.status === 200) {
    console.log(`Database seedet med ${bru.getEnvVar("Seed-User-Count") || 10} brugere succesfuldt.`);
  } else {
    console.log("Seedning af users fejlede. Status:", res.status);
  }
}

tests {
  test("Users seed returnerer 200 OK", function() {
    expect(res.status).to.equal(200);
  });
}
