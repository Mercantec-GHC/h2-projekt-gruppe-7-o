meta {
  name: Gets a specific hotel by ID.
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/Hotels/{{Hotel-Id}}
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{JWT-User}}
}

script:post-response {
  if (res.status === 200 && res.body) {
    console.log("Hotel hentet succesfuldt:", res.body);
  } else {
    console.log("Hentning fejlede. Status:", res.status);
  }
}

tests {
  test("Get hotel returnerer 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  test("Response indeholder korrekt hotel ID", function() {
    expect(res.body.id).to.equal(bru.getEnvVar("Hotel-Id"));
  });
}
