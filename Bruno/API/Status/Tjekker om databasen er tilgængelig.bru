meta {
  name: Tjekker om databasen er tilgængelig
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/Status/dbhealthcheck
  body: none
  auth: none
}

headers {
  Authorization: {{apiKey}}
}

script:post-response {
  if (res.status === 200 && res.body) {
    console.log("DB Healthcheck succesfuld:", res.body);
  } else {
    console.log("DB Healthcheck fejlede. Status:", res.status);
  }
}

tests {
  // Test status kode
  test("Status kode skal være 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  // Test at responset ikke er tomt
  test("Response skal ikke være tom", function() {
    expect(res.body).to.not.be.empty;
  });

  // Test at responset har en status egenskab
  test("Response skal have status egenskab", function() {
    expect(res.body).to.have.property("status");
  });

   // Test at responset har en status egenskab og den er 'OK'
  test("Response skal have status egenskab med værdi 'OK'", function() {
    expect(res.body).to.have.property("status");
    expect(res.body.status).to.equal("OK");
  });
  

    // Test at bookingsCount eksisterer og er et tal
  test("Response skal have bookingsCount som et tal", function() {
    expect(res.body).to.have.property("bookingsCount");
    expect(res.body.bookingsCount).to.be.a("number");
  });
}
